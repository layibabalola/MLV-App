{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://softwarefactory.invalid/schemas/universal-evidence-capsule-request-v1.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "maxBytes", "maxSourceBytes", "maxAmplificationRatio", "slices"],
  "properties": {
    "schema": {"const": "fleet-universal-evidence-capsule-request/v1"},
    "maxBytes": {"type": "integer", "minimum": 1, "maximum": 262144},
    "maxSourceBytes": {"type": "integer", "minimum": 1, "maximum": 16777216},
    "maxAmplificationRatio": {"type": "integer", "minimum": 1, "maximum": 64},
    "slices": {
      "type": "array", "minItems": 1, "maxItems": 256,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["localPath", "reference", "offset", "length", "sourceSha256"],
        "properties": {
          "localPath": {"type": "string", "minLength": 1, "maxLength": 1024},
          "reference": {"type": "string", "pattern": "^[A-Za-z0-9._-]+(?:/[A-Za-z0-9._-]+)*$", "maxLength": 512},
          "offset": {"type": "integer", "minimum": 0, "maximum": 1099511627776},
          "length": {"type": "integer", "minimum": 1, "maximum": 262144},
          "sourceSha256": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}
        }
      }
    }
  }
}
