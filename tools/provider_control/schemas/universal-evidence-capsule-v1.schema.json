{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://softwarefactory.invalid/schemas/universal-evidence-capsule-v1.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "capsuleSha256", "payloadBytes", "sliceCount", "temporaryCleanup", "slices"],
  "properties": {
    "schema": {"const": "fleet-universal-evidence-capsule/v1"},
    "capsuleSha256": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "payloadBytes": {"type": "integer", "minimum": 1, "maximum": 262144},
    "sliceCount": {"type": "integer", "minimum": 1, "maximum": 256},
    "temporaryCleanup": {"enum": ["CLEAN", "REFUSED_BOUNDED"]},
    "slices": {
      "type": "array", "minItems": 1, "maxItems": 256,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["reference", "offset", "length", "sliceSha256"],
        "properties": {
          "reference": {"type": "string", "pattern": "^[A-Za-z0-9._-]+(?:/[A-Za-z0-9._-]+)*$", "maxLength": 512},
          "offset": {"type": "integer", "minimum": 0, "maximum": 1099511627776},
          "length": {"type": "integer", "minimum": 1, "maximum": 262144},
          "sliceSha256": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}
        }
      }
    }
  }
}
