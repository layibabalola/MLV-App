{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mlv.app/schemas/sealed-real-clip-ab-receipt-v1.json",
  "title": "MLV App sealed real-clip A/B receipt",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "capturedAtUtc",
    "disposition",
    "candidate",
    "baseline",
    "verifier",
    "renderContract",
    "clips",
    "coverage",
    "retention",
    "scope"
  ],
  "properties": {
    "schema": { "const": "mlv-app/sealed-real-clip-ab-receipt/v1" },
    "capturedAtUtc": { "$ref": "#/$defs/utcTimestamp" },
    "disposition": {
      "const": "LOCAL_SEALED_CORPUS_PASS_PENDING_HOSTED_AND_INDEPENDENT_RATIFICATION"
    },
    "candidate": { "$ref": "#/$defs/candidate" },
    "baseline": { "$ref": "#/$defs/baseline" },
    "verifier": { "$ref": "#/$defs/verifier" },
    "renderContract": { "$ref": "#/$defs/renderContract" },
    "clips": {
      "type": "array",
      "minItems": 1,
      "maxItems": 7,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/clip" }
    },
    "coverage": { "$ref": "#/$defs/coverage" },
    "retention": { "$ref": "#/$defs/retention" },
    "scope": { "$ref": "#/$defs/scope" }
  },
  "$defs": {
    "gitObject": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "sha256": {
      "type": "string",
      "pattern": "^[0-9A-F]{64}$"
    },
    "utcTimestamp": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(?:\\.[0-9]{1,9})?Z$"
    },
    "candidate": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "productHead",
        "productTree",
        "exeSha256",
        "buildManifestSha256",
        "clean",
        "selfContained",
        "launchProbeExitCode"
      ],
      "properties": {
        "productHead": { "$ref": "#/$defs/gitObject" },
        "productTree": { "$ref": "#/$defs/gitObject" },
        "exeSha256": { "$ref": "#/$defs/sha256" },
        "buildManifestSha256": { "$ref": "#/$defs/sha256" },
        "clean": { "const": true },
        "selfContained": { "const": true },
        "launchProbeExitCode": { "const": 0 }
      }
    },
    "baseline": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "protectedProductHead",
        "protectedProductTree",
        "instrumentedHead",
        "instrumentedTree",
        "instrumentationOnlyPaths",
        "exeSha256",
        "buildManifestSha256",
        "clean",
        "selfContained",
        "launchProbeExitCode"
      ],
      "properties": {
        "protectedProductHead": { "$ref": "#/$defs/gitObject" },
        "protectedProductTree": { "$ref": "#/$defs/gitObject" },
        "instrumentedHead": { "$ref": "#/$defs/gitObject" },
        "instrumentedTree": { "$ref": "#/$defs/gitObject" },
        "instrumentationOnlyPaths": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1,
            "pattern": "^[^\\\\]+(?:/[^\\\\]+)*$"
          }
        },
        "exeSha256": { "$ref": "#/$defs/sha256" },
        "buildManifestSha256": { "$ref": "#/$defs/sha256" },
        "clean": { "const": true },
        "selfContained": { "const": true },
        "launchProbeExitCode": { "const": 0 }
      }
    },
    "verifier": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "head",
        "tree",
        "sourceHashConvention",
        "comparerGitBlob",
        "comparerSha256",
        "runnerGitBlob",
        "runnerSha256",
        "schema",
        "maxMeanAbsRgbDelta",
        "maxChangedSampleRatio",
        "sampleStep",
        "failOnScreenshotDelta"
      ],
      "properties": {
        "head": { "$ref": "#/$defs/gitObject" },
        "tree": { "$ref": "#/$defs/gitObject" },
        "sourceHashConvention": { "const": "GIT_BLOB_BYTES_CANONICAL_LF" },
        "comparerGitBlob": { "$ref": "#/$defs/gitObject" },
        "comparerSha256": { "$ref": "#/$defs/sha256" },
        "runnerGitBlob": { "$ref": "#/$defs/gitObject" },
        "runnerSha256": { "$ref": "#/$defs/sha256" },
        "schema": { "const": "gui-smoke-ab-compare.v3" },
        "maxMeanAbsRgbDelta": {
          "type": "number",
          "minimum": 0,
          "maximum": 2
        },
        "maxChangedSampleRatio": {
          "type": "number",
          "minimum": 0,
          "maximum": 0.01
        },
        "sampleStep": { "type": "integer", "minimum": 1, "maximum": 4 },
        "failOnScreenshotDelta": { "const": true }
      }
    },
    "renderContract": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "receiptGitBlob",
        "receiptSha256",
        "lookAssistEnabled",
        "workerThreads",
        "qualityMode",
        "scaleRequest",
        "dropFrame",
        "targetPresentedFrames",
        "captureFrameLocked",
        "fullVisualStateRequiredEqual",
        "captureTimeExecutableClipReceiptManifestLogAndScreenshotBindingsRequired"
      ],
      "properties": {
        "receiptGitBlob": { "$ref": "#/$defs/gitObject" },
        "receiptSha256": { "$ref": "#/$defs/sha256" },
        "lookAssistEnabled": { "const": false },
        "workerThreads": { "const": 1 },
        "qualityMode": { "const": "auto" },
        "scaleRequest": { "const": 4 },
        "dropFrame": { "const": false },
        "targetPresentedFrames": { "const": 2 },
        "captureFrameLocked": { "const": true },
        "fullVisualStateRequiredEqual": { "const": true },
        "captureTimeExecutableClipReceiptManifestLogAndScreenshotBindingsRequired": {
          "const": true
        }
      }
    },
    "clip": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "clipSha256",
        "frame",
        "verdict",
        "sameScreenshotSha256",
        "beforeScreenshotSha256",
        "afterScreenshotSha256",
        "meanAbsRgbDelta",
        "maxAbsRgbDelta",
        "changedSampleRatio",
        "beforeSmokeJsonSha256",
        "afterSmokeJsonSha256",
        "comparisonJsonSha256"
      ],
      "properties": {
        "name": {
          "enum": [
            "M16-1327",
            "M16-1347",
            "M17-1207",
            "M15-1320",
            "M16-1210",
            "M16-1243",
            "M02-1344"
          ]
        },
        "clipSha256": { "$ref": "#/$defs/sha256" },
        "frame": { "type": "integer", "minimum": 1 },
        "verdict": { "const": "PASS" },
        "sameScreenshotSha256": { "const": true },
        "beforeScreenshotSha256": { "$ref": "#/$defs/sha256" },
        "afterScreenshotSha256": { "$ref": "#/$defs/sha256" },
        "meanAbsRgbDelta": { "const": 0 },
        "maxAbsRgbDelta": { "const": 0 },
        "changedSampleRatio": { "const": 0 },
        "beforeSmokeJsonSha256": { "$ref": "#/$defs/sha256" },
        "afterSmokeJsonSha256": { "$ref": "#/$defs/sha256" },
        "comparisonJsonSha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "coverage": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "requiredNamedClips",
        "availableAndPassed",
        "unavailable",
        "allAvailablePassed",
        "gpuPlaybackCovered",
        "dngCdngExportCoveredByThisReceipt",
        "batchHeadlessCoveredByThisReceipt",
        "cadenceDisposition"
      ],
      "properties": {
        "requiredNamedClips": {
          "type": "array",
          "minItems": 7,
          "maxItems": 7,
          "uniqueItems": true,
          "items": { "type": "string" }
        },
        "availableAndPassed": { "type": "integer", "minimum": 1, "maximum": 7 },
        "unavailable": {
          "type": "array",
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        },
        "allAvailablePassed": { "const": true },
        "gpuPlaybackCovered": { "const": false },
        "dngCdngExportCoveredByThisReceipt": { "const": false },
        "batchHeadlessCoveredByThisReceipt": { "const": false },
        "cadenceDisposition": { "const": "ADVISORY_EXACT_TWO_PRESENTED_FRAMES_ONLY" }
      }
    },
    "retention": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "rawArtifactsCommitted",
        "rawArtifacts",
        "comparisonReceiptsCommitted",
        "independentRecomputationRequiresRetainedLocalArtifacts",
        "hostedPromotionRequired"
      ],
      "properties": {
        "rawArtifactsCommitted": { "const": false },
        "rawArtifacts": { "const": "LOCAL_IGNORED_HASH_BOUND" },
        "comparisonReceiptsCommitted": { "const": false },
        "independentRecomputationRequiresRetainedLocalArtifacts": { "const": true },
        "hostedPromotionRequired": { "const": true }
      }
    },
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "providerAuthority",
        "automaticLaunchGate",
        "mergeAuthority",
        "releaseAuthority",
        "reblessAuthority",
        "humanBeforeAfterReviewRequired",
        "independentAuditRequired"
      ],
      "properties": {
        "providerAuthority": { "const": false },
        "automaticLaunchGate": { "const": "CLOSED" },
        "mergeAuthority": { "const": false },
        "releaseAuthority": { "const": false },
        "reblessAuthority": { "const": false },
        "humanBeforeAfterReviewRequired": { "const": true },
        "independentAuditRequired": { "const": true }
      }
    }
  }
}
